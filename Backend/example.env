# ===========================================================
# Backend environment variables — EXAMPLE TEMPLATE
# Copy this file to ".env" and fill in your own values.
# Do NOT put real secrets in this file (it is committed to git).
# ===========================================================

# --- Database ---
MONGO_URI=your_mongodb_connection_string

# --- Auth ---
JWT_SECRET=your_long_random_secret

# --- Cloudinary (image / file uploads) ---
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# --- Server ---
PORT=5011
NODE_ENV=development

# --- CORS (comma separated frontend origins, no trailing slash) ---
CORS_ORIGIN=http://localhost:5173

# --- AI job recommendations (job.controller.js, OpenAI-compatible endpoint) ---
# This is separate from the ai-service microservice below.
AI_BASE_URL=https://api.clod.io/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=openai/gpt-oss-120b

# --- AI microservice (resume analysis, matching, RAG assistant, interviews,
# reports — see /ai-service). URL of that FastAPI service; defaults to
# http://localhost:8000 if unset, which is fine for local development.
AI_SERVICE_URL=http://localhost:8000

# --- Email (used for OTP verification). Use EITHER of the two options
# below — EMAIL_PASS (a Gmail App Password) is the simpler option and
# takes priority if both are set; OAuth2 is the alternative.
EMAIL_USER=your_gmail_address
# Option A - Gmail App Password (simplest):
EMAIL_PASS=your_gmail_app_password
# Option B - Google OAuth2 (used only if EMAIL_PASS is not set):
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
REFRESH_TOKEN=your_google_oauth_refresh_token
