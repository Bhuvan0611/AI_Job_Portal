# Optional. Leave unset for local development — the app defaults to
# http://localhost:5011 (see src/utils/data.js).
#
# For a production build where the Express backend serves this app's
# `dist/` folder from the same origin (see Backend/index.js), set this to
# an empty string so API calls use same-origin relative paths:
#   VITE_API_BASE_URL=
#
# If the frontend and backend are deployed to different origins instead,
# set this to the backend's full URL:
#   VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
